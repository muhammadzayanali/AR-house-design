# Copy this file to backend/.env and fill in values.
# Never commit backend/.env — it is gitignored.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Optional: Netlify site origin(s) when frontend is hosted there and API is local.
# With DJANGO_DEBUG=true, CORS allows all origins already.
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app

# Hugging Face (optional — local RAG works without this). Keep private.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_PROVIDER=auto
HF_TIMEOUT=25
