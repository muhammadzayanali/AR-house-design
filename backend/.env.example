# Copy this file to backend/.env and fill in your token.
# Never commit .env.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Hugging Face Inference Providers (optional polish — local RAG works without this)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_PROVIDER=auto
HF_TIMEOUT=25
