# Copy to frontend/.env.local (gitignored). Never commit real secrets here.

# Netlify production: set NEXT_PUBLIC_API_ORIGIN to your live localtunnel URL
# (see netlify.toml). Leave unset for local Next → Django rewrites.
# NEXT_PUBLIC_API_ORIGIN=https://late-zebras-end.loca.lt

# Optional server-side rewrite target for local Next only:
# DJANGO_ORIGIN=http://127.0.0.1:8000

# Do NOT put HF_TOKEN or DJANGO_SECRET_KEY in the frontend.
