# Copy to frontend/.env.local (gitignored). Never commit real secrets here.

# Leave NEXT_PUBLIC_API_ORIGIN unset for local Next+Django and for Netlify
# (same-origin /api rewrites). Only set it for special LAN debugging.
# NEXT_PUBLIC_API_ORIGIN=http://192.168.2.105:8000

# Server-side rewrite target used by next.config.ts:
# Local: http://127.0.0.1:8000 (default)
# Netlify: HTTPS tunnel to your laptop Django, e.g.
# DJANGO_ORIGIN=https://floppy-towns-invite.loca.lt

# Do NOT put HF_TOKEN or DJANGO_SECRET_KEY in the frontend.
