# Copy to frontend/.env.local (gitignored). Never commit real secrets here.

# Netlify production uses the tunnel host in docs/DEMO_READINESS.md
# (also frontend/.env.production and netlify.toml). Leave unset for local Next → Django rewrites.
# NEXT_PUBLIC_API_ORIGIN=https://inbox-sbjct-dominant-dating.trycloudflare.com

# Optional server-side rewrite target for local Next only:
# DJANGO_ORIGIN=http://127.0.0.1:8000

# Do NOT put HF_TOKEN or DJANGO_SECRET_KEY in the frontend.
