# Copy to frontend/.env.local (gitignored). Never commit real secrets here.

# When frontend is on Netlify and Django runs on your laptop,
# set this to your Mac LAN IP so the browser talks to local Django:
# NEXT_PUBLIC_API_ORIGIN=http://192.168.1.140:8000
#
# Leave unset for local Next+Django (uses same-origin /api rewrites).

# Optional server-side rewrite target (local Next only; Netlify cannot reach your localhost):
# DJANGO_ORIGIN=http://127.0.0.1:8000

# Do NOT put HF_TOKEN or DJANGO_SECRET_KEY in the frontend.
