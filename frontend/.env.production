# Production (Netlify): phone browser → HTTPS tunnel → local Django.
# Keep localtunnel running while using the Netlify site:
#   npx -y localtunnel --port 8000 --subdomain late-zebras-end
# Prefer a fixed --subdomain so Netlify env does not break when the tunnel restarts.
NEXT_PUBLIC_API_ORIGIN=https://late-zebras-end.loca.lt
DJANGO_ORIGIN=https://late-zebras-end.loca.lt
