# Production (Netlify): browser calls same-origin /api; Next rewrites to the tunnel.
# Keep localtunnel running while using the Netlify site:
#   npx -y localtunnel --port 8000
# Update DJANGO_ORIGIN if localtunnel prints a new URL. Do NOT set NEXT_PUBLIC_API_ORIGIN
# (that forces the phone browser to talk to *.loca.lt → CORS / 511 failures).
DJANGO_ORIGIN=https://floppy-towns-invite.loca.lt
